# Yana configuration
#
# Every variable below is one the code actually reads -- found with
#   grep -rhoE "process\.env\.[A-Z_]+" src/
# rather than from memory. When you add a variable, add it here in the same
# commit; when you remove one, delete it here. A documented variable that
# nothing reads is worse than an undocumented one.
#
# Copy to .env to override. All values shown are the defaults.

# ============================================================================
# DATABASE
# ============================================================================

# DATABASE_PATH - Path to the SQLite file.
# DEFAULT (local):  ./data/yana.db   (src/lib/db/client.ts)
# DEFAULT (Docker): /app/data/yana.db (pinned in the Dockerfile)
# The directory is created on first connection if missing. Yana is SQLite-only:
# the schema, the PRAGMAs and the job queue all assume it, and there is no
# alternative engine.
# DATABASE_PATH=./data/yana.db

# ============================================================================
# AUTHENTICATION
# ============================================================================

# BETTER_AUTH_SECRET - Signs session cookies and every token Better Auth mints.
# DEFAULT: none. Read by the library itself, not by src/, so the grep above
# does not find it. Documented here because a deployment without it is broken
# in a way nothing obvious reports.
# Better Auth falls back to a well-known development secret when this is unset,
# and treats that fallback as a hard error under NODE_ENV=production -- the
# shared default would let anyone forge a session cookie. The container still
# starts and /health still passes; what fails is every /api/auth/* request, so
# nobody can log in (and the failure can surface as an unhandled rejection at
# module load, which can kill the worker rather than 500 the route). Set it in
# every real deployment, and understand that changing it logs everyone out.
#   openssl rand -base64 32
# BETTER_AUTH_SECRET=

# BETTER_AUTH_URL - The externally reachable origin, e.g. https://yana.example.
# DEFAULT: unset; Better Auth then derives the origin from each request. Also
# read by the library rather than by src/. Setting it silences a startup
# warning and is what makes redirects correct behind a reverse proxy.
# BETTER_AUTH_URL=

# PASSKEY_RP_ID - The WebAuthn Relying Party ID: the registrable domain, with
# no scheme and no port.
# DEFAULT: localhost (src/lib/auth/server.ts)
# It must equal the host the browser shows, or be a registrable parent of it.
# A mismatch makes the browser refuse the credential with a generic error that
# names nothing -- this is the single most common passkey misconfiguration.
# Changing it invalidates every passkey already registered.
# PASSKEY_RP_ID=localhost

# PUBLIC_URL - The full origin WebAuthn ceremonies must originate from,
# including scheme and port.
# DEFAULT: http://localhost:3000 (src/lib/auth/server.ts)
# No trailing slash. Unlike PASSKEY_RP_ID this is the *whole* origin, so the
# two differ in production: PASSKEY_RP_ID=yana.example with
# PUBLIC_URL=https://yana.example.
# PUBLIC_URL=http://localhost:3000

# ============================================================================
# PRESENTATION
# ============================================================================

# TZ - The time zone every date in the UI is formatted in.
# DEFAULT: UTC (src/i18n/request.ts)
# next-intl otherwise falls back to the *environment's* zone, which is the
# container's on the server and the visitor's own in the browser -- so a date
# rendered in both places can differ by a day and React reports a hydration
# mismatch. Setting one value makes both sides agree. Per-user time zones do
# not exist in this application; this is the whole deployment's.
# TZ=Europe/Berlin

# ============================================================================
# SERVER (read by Next's standalone server, not by application code)
# ============================================================================

# PORT - Port the server listens on.
# DEFAULT: 3000
# PORT=3000

# HOSTNAME - Interface to bind. The Dockerfile pins this to 0.0.0.0 because
# Docker sets HOSTNAME to the container ID, which the server would otherwise
# try to bind (see the Dockerfile comment). Leave unset locally.
# HOSTNAME=0.0.0.0

# NEXT_TELEMETRY_DISABLED - Set to 1 to opt out of Next.js telemetry.
# DEFAULT: unset (telemetry enabled); the Dockerfile sets 1.
# NEXT_TELEMETRY_DISABLED=1
