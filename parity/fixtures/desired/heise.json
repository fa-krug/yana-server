    "name": "Visual Studio Code 1.131 bringt Diktierfunktion für Chat, Editor und Terminal",
    "plainTextLength": 2564
  },
  "curation": {
    "desiredBlockCount": 16,
    "rawBlockCount": 16,
    "remoteRefsNeedingLocalization": [],
